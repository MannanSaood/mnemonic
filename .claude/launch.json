{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mnemonic-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "mnemonic-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "-d",
        "out"
      ],
      "port": 4173
    },
    {
      "name": "mnemonic-pages",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4180",
        "-d",
        "../mnemonic-site"
      ],
      "port": 4180
    },
    {
      "name": "mnemonic-ci",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4190",
        "-d",
        "../mnemonic-ci/out"
      ],
      "port": 4190
    }
  ]
}